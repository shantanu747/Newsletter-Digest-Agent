<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Signals Report</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    @media screen and (max-width: 600px) {
      .container { padding: 16px !important; }
      .header { padding: 32px 24px !important; }
      .section { padding: 24px 20px !important; }
      .footer { padding: 32px 24px !important; }
      h1 { font-size: 28px !important; }
      h2 { font-size: 18px !important; }
    }
    html { scroll-behavior: smooth; }
    a { transition: opacity 0.2s ease; }
    a:hover { opacity: 0.7; }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #faf9f7; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1d1d1f; line-height: 1.6; -webkit-font-smoothing: antialiased;">

{% macro confidence_badge(level) -%}
{% if level == 'HIGH' %}
<span style="display: inline-block; font-size: 10px; font-weight: 600; color: #a13a3a; background-color: #fbeceb; padding: 3px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 0.04em;">High Confidence</span>
{% elif level == 'MEDIUM' %}
<span style="display: inline-block; font-size: 10px; font-weight: 600; color: #b8863a; background-color: #fdf5e8; padding: 3px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 0.04em;">Medium Confidence</span>
{% else %}
<span style="display: inline-block; font-size: 10px; font-weight: 600; color: #6b6b70; background-color: #f0eeeb; padding: 3px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 0.04em;">Low Confidence</span>
{% endif %}
{%- endmacro %}

{% macro item_card(item) %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #fefefe; border-radius: 14px; margin-bottom: 14px;">
  <tr>
    <td style="padding: 18px 20px;">
      <p style="margin: 0 0 8px; font-size: 15px; font-weight: 600; color: #1d1d1f; letter-spacing: -0.1px;">{{ item.headline }}</p>
      <p style="margin: 0 0 12px; font-size: 14px; font-weight: 400; color: #3a3a3c; line-height: 1.7;">{{ item.body | nl2br }}</p>
      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td>{{ confidence_badge(item.confidence) }}</td>
          {% if item.entities %}
          <td style="padding-left: 8px; font-size: 12px; color: #a1a1a6;">{{ item.entities | join(', ') }}</td>
          {% endif %}
        </tr>
      </table>
    </td>
  </tr>
</table>
{% endmacro %}

{% macro item_section(title, items) %}
{% if items %}
<tr>
  <td class="section" style="padding: 8px 40px 32px;">
    <p style="margin: 0 0 14px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #86868b;">{{ title }}</p>
    {% for item in items %}{{ item_card(item) }}{% endfor %}
  </td>
</tr>
{% endif %}
{% endmacro %}

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #faf9f7;">
  <tr>
    <td align="center" style="padding: 40px 20px;">

      <table role="presentation" class="container" width="600" cellspacing="0" cellpadding="0" border="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.04);">

        <!-- Header -->
        <tr>
          <td class="header" style="padding: 48px 40px 32px; background: linear-gradient(135deg, #fefefe 0%, #f8f7f5 100%); border-bottom: 1px solid #f0eeeb;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 24px;">
              <tr>
                <td style="width: 44px; height: 44px; background: linear-gradient(135deg, #7c9a6a 0%, #6a8558 100%); border-radius: 12px; text-align: center; vertical-align: middle; box-shadow: 0 2px 8px rgba(124,154,106,0.3);">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: 0 auto;">
                    <path d="M4 16L9 10L13 14L20 6" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </td>
                <td style="padding-left: 14px; vertical-align: middle;">
                  <span style="font-size: 15px; font-weight: 600; color: #86868b; letter-spacing: -0.2px;">Signals</span>
                </td>
              </tr>
            </table>
            <h1 style="margin: 0 0 8px; font-size: 32px; font-weight: 700; color: #1d1d1f; letter-spacing: -0.5px; line-height: 1.2;">Signals Report</h1>
            <p style="margin: 0; font-size: 14px; color: #86868b; font-weight: 400;">
              {{ run_date.strftime('%A, %B %-d, %Y') }}
              <span style="color: #7c9a6a;">&middot;</span> Trailing {{ report.window_days }}-day window
              <span style="color: #7c9a6a;">&middot;</span> {{ report.observation_count }} observation{{ 's' if report.observation_count != 1 }}
            </p>
          </td>
        </tr>

        <!-- Cold-start banner -->
        {% if report.is_cold_start %}
        <tr>
          <td style="padding: 24px 40px 0;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-radius: 12px; overflow: hidden; background-color: #f0f5fb; border-left: 4px solid #4a8fc2;">
              <tr>
                <td style="padding: 16px 20px;">
                  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #3a3a3c;">
                    <strong>Still building history.</strong> This report covers less than two full trend windows, so trends may firm up as more newsletters are processed.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {% if report.macro %}
        <tr>
          <td class="section" style="padding: 32px 40px 8px;">
            <p style="margin: 0 0 14px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #86868b;">Macro Dashboard</p>
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f8f7f5; border-radius: 16px; overflow: hidden;">
              <tr>
                <td style="padding: 20px 24px;">
                  {% for ind in report.macro.indicators %}
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="{% if not loop.last %}margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #ede9e4;{% endif %}">
                    <tr>
                      <td>
                        <span style="font-size: 14px; font-weight: 500; color: #1d1d1f;">{{ ind.label }}</span>
                        {% if ind.alarm %}<span style="margin-left: 8px; display: inline-block; font-size: 10px; font-weight: 600; color: #a13a3a; background-color: #fbeceb; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: 0.04em;">Alarm</span>{% endif %}
                        <div style="font-size: 12px; color: #86868b; margin-top: 2px;">{{ ind.value }} as of {{ ind.as_of }} &middot; {{ ind.direction }}{% if ind.note %} &middot; {{ ind.note }}{% endif %}</div>
                      </td>
                    </tr>
                  </table>
                  {% endfor %}
                  {% if report.macro.partial %}
                  <p style="margin: 8px 0 0; font-size: 11px; color: #a1a1a6;">Some indicators could not be fetched this run.</p>
                  {% endif %}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {{ item_section('Accelerating Risks', report.risks) }}
        {{ item_section('Opportunities', report.opportunities) }}
        {{ item_section('Emerging Themes', report.emerging) }}
        {{ item_section('Fading Stories', report.fading) }}
        {{ item_section('Watch Items', report.watch) }}

        {% if not (report.risks or report.opportunities or report.emerging or report.fading or report.watch) %}
        <tr>
          <td class="section" style="padding: 8px 40px 32px;">
            <p style="margin: 0; font-size: 14px; color: #86868b;">No signals cleared the eligibility bar this window.</p>
          </td>
        </tr>
        {% endif %}

        <!-- Footer -->
        <tr>
          <td class="footer" style="padding: 40px; background-color: #f8f7f5; border-top: 1px solid #f0eeeb;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td style="text-align: center;">
                  <p style="margin: 0 0 8px; font-size: 13px; color: #86868b; font-weight: 500;">Newsletter Digest Agent</p>
                  <p style="margin: 0; font-size: 12px; color: #a1a1a6; line-height: 1.6;">
                    This is a reading assistant, not investment advice. Signals are drawn from newsletter mention patterns only and may be wrong or incomplete.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
